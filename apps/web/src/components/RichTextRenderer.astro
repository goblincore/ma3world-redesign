---
import { getMediaUrl } from '../lib/cms';

const { node } = Astro.props;

interface TextNode {
  text: string;
  format: number; // bitmask for bold, italic, etc.
  bold?: boolean;
  italic?: boolean;
  underline?: boolean;
  strikethrough?: boolean;
  code?: boolean;
}

// Helper to handle text formatting
const IS_BOLD = 1;
const IS_ITALIC = 1 << 1;
const IS_STRIKETHROUGH = 1 << 2;
const IS_UNDERLINE = 1 << 3;
const IS_CODE = 1 << 4;
const IS_SUBSCRIPT = 1 << 5;
const IS_SUPERSCRIPT = 1 << 6;

function getTextClasses(format: number) {
  const classes = [];
  if (format & IS_BOLD) classes.push('font-bold');
  if (format & IS_ITALIC) classes.push('italic');
  if (format & IS_STRIKETHROUGH) classes.push('line-through');
  if (format & IS_UNDERLINE) classes.push('underline');
  if (format & IS_CODE) classes.push('font-mono bg-theme-muted/10 px-1 rounded');
  return classes.join(' ');
}
---

{/* Recursive rendering based on node type */}
{(() => {
  if (!node) return null;

  if (node.type === 'text') {
    const classes = getTextClasses(node.format);
    return classes ? <span class={classes}>{node.text}</span> : <>{node.text}</>;
  }

  if (node.type === 'paragraph') {
    return (
      <p class="mb-4 leading-relaxed">
        {node.children?.map((child: any) => <Astro.self node={child} />)}
      </p>
    );
  }

  if (node.type === 'heading') {
    const Tag = node.tag as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
    return (
      <Tag class="font-bold">
        {node.children?.map((child: any) => <Astro.self node={child} />)}
      </Tag>
    );
  }

  if (node.type === 'quote') {
    return (
      <blockquote class="relative border-l-4 border-theme-alt/30 pl-10 my-16 italic text-theme-muted quote-content">
        {node.children?.map((child: any) => <Astro.self node={child} />)}
      </blockquote>
    );
  }

  if (node.type === 'list') {
    const Tag = node.tag === 'ol' ? 'ol' : 'ul';
    const classes = node.tag === 'ol' ? 'list-decimal' : 'list-disc';
    return (
      <Tag class={`${classes} pl-6 mb-4 space-y-1`}>
        {node.children?.map((child: any) => <Astro.self node={child} />)}
      </Tag>
    );
  }

  if (node.type === 'listitem') {
    return (
      <li>
        {node.children?.map((child: any) => <Astro.self node={child} />)}
      </li>
    );
  }
  
  if (node.type === 'link') {
     const url = node.fields?.url || '#';
     const isExternal = url.startsWith('http');
     const target = node.fields?.newTab || isExternal ? "_blank" : "_self";
     const rel = target === "_blank" ? "noopener noreferrer" : undefined;
     
     return (
        <a href={url} target={target} rel={rel} class="underline text-theme-alt hover:opacity-80">
            {node.children?.map((child: any) => <Astro.self node={child} />)}
        </a>
     )
  }

  if (node.type === 'upload') {
    const isVideo = node.value?.mimeType?.startsWith('video/');
    const mediaUrl = getMediaUrl(node.value, isVideo ? undefined : { width: 1200 });
    
    if (!mediaUrl) return null;

    return (
      <div class="my-12 flex flex-col items-center">
        {isVideo ? (
          <video 
            src={mediaUrl} 
            poster={getMediaUrl(node.value?.thumbnail)}
            controls 
            playsinline
            class="w-full aspect-video rounded-sm block bg-theme-muted/20"
          />
        ) : (
          <img 
            src={mediaUrl} 
            alt={node.value?.alt || ''} 
            class="max-w-full h-auto rounded-sm block"
            loading="lazy"
          />
        )}
        {node.fields?.caption && (
          <p class="mt-4 text-sm text-theme-muted italic text-center">
            {node.fields.caption}
          </p>
        )}
      </div>
    );
  }

  if (node.type === 'block') {
    const fields = node.fields || node.value;
    if (!fields) return null;
    
    const blockType = fields.blockType;
    if (blockType === 'youtube') {
      const url = fields.url;
      if (!url) return null;
      // Extract video ID from URL
      let videoId = '';
      if (url.includes('youtube.com/watch?v=')) {
        videoId = url.split('v=')[1].split('&')[0];
      } else if (url.includes('youtu.be/')) {
        videoId = url.split('youtu.be/')[1].split('?')[0];
      } else if (url.includes('youtube.com/embed/')) {
        videoId = url.split('embed/')[1].split('?')[0];
      }

      if (videoId) {
        return (
          <div class="my-8">
            <div class="relative w-full aspect-video rounded-sm overflow-hidden bg-theme-muted">
              <iframe
                src={`https://www.youtube.com/embed/${videoId}`}
                title={fields.caption || 'YouTube video player'}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="absolute inset-0 w-full h-full"
              ></iframe>
            </div>
            {fields.caption && (
              <p class="mt-2 text-sm text-theme-muted italic text-center">
                {fields.caption}
              </p>
            )}
          </div>
        );
      }
    }
  }

  // Root or other container nodes
  if (node.children) {
    return (
      <>
        {node.children.map((child: any) => <Astro.self node={child} />)}
      </>
    );
  }

  return null;
})()}
