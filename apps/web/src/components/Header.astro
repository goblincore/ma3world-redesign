---
interface Props {
  transparent?: boolean;
  showNews?: boolean;
  showJournal?: boolean;
}

import LogoGlobe from './LogoGlobe.astro';

const { 
  transparent = true, 
  showNews = true, 
  showJournal = true 
} = Astro.props;

const base = import.meta.env.BASE_URL;
const isHome = Astro.url.pathname === base || Astro.url.pathname === base.replace(/\/$/, "");

const aboutHref = isHome ? "#about" : base + "#about";
const projectsHref = isHome ? "#projects" : base + "#projects";
const contactHref = isHome ? "#contact" : base + "#contact";
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-transparent">
  <nav class="flex items-center justify-between px-6 md:px-12 py-4">
    <!-- Logo / Greeting with bubble - negative margin compensates for bubble padding -->
    <a href={base} class="header-bubble logo-bubble min-w-[150px] md:min-w-[200px] flex items-center relative h-12 group overflow-hidden rounded-full pl-4 pr-6 -ml-4 transition-[opacity,transform,background-color] duration-500">
      <!-- Greeting (visible only when hero is in view on Home) -->
      {isHome && (
        <span id="header-greeting" class="text-lg md:text-xl font-serif tracking-wide opacity-0 absolute left-4 translate-y-0 flex items-center" style="transition: opacity 0.3s ease;">
          <svg class="w-6 h-6 opacity-40" viewBox="0 0 100 100" fill="currentColor">
            <path d="M50 50 C25 20 5 35 15 55 C20 70 45 65 50 60 C45 70 25 90 15 80 C5 70 25 50 50 55" />
            <path d="M50 50 C75 20 95 35 85 55 C80 70 55 65 50 60 C55 70 75 90 85 80 C95 70 75 50 50 55" />
          </svg>
        </span>
      )}
      
      <!-- LogoGlobe (visible when scrolled or on other routes) -->
      <div id="header-logo" class="opacity-0 absolute left-4 pointer-events-none" style="transition: opacity 0.3s ease;">
        <LogoGlobe className="relative w-28 md:w-36" />
      </div>
    </a>
    
    <!-- Navigation Links with bubble - negative margin compensates for bubble padding -->
    <div class="header-bubble nav-bubble hidden md:flex items-center gap-6 text-sm tracking-wide rounded-full px-6 py-2.5 -mr-4 transition-all duration-500">
      {showNews && (
        <a href={base + "news"} class="hover:opacity-60 transition-opacity">
          <span class="lang-en">News</span>
          <span class="lang-ja">ニュース</span>
        </a>
      )}
      <a href={aboutHref} class="hover:opacity-60 transition-opacity">
        <span class="lang-en">About</span>
        <span class="lang-ja">私たちについて</span>
      </a>
      <a href={projectsHref} class="hover:opacity-60 transition-opacity">
        <span class="lang-en">Projects</span>
        <span class="lang-ja">プロジェクト</span>
      </a>
      <a href={contactHref} class="hover:opacity-60 transition-opacity">
        <span class="lang-en">Contact</span>
        <span class="lang-ja">お問い合わせ</span>
      </a>
      {showJournal && (
        <a href={base + "journal"} class="hover:opacity-60 transition-opacity">
          <span class="lang-en">Journal</span>
          <span class="lang-ja">ジャーナル</span>
        </a>
      )}
      
      <span class="w-px h-4 bg-current opacity-20"></span>
      
      <!-- Language Toggle -->
      <div class="flex items-center gap-2 text-xs font-bold tracking-widest opacity-60 hover:opacity-100 transition-opacity">
        <button id="lang-en" class="hover:opacity-100 transition-opacity cursor-pointer">EN</button>
        <span class="opacity-30">/</span>
        <button id="lang-ja" class="hover:opacity-100 transition-opacity cursor-pointer text-[10px] md:text-xs">日本語</button>
      </div>

      <!-- Theme Toggle -->
      <button id="theme-toggle" class="w-7 h-7 flex items-center justify-center rounded-full border border-current opacity-60 hover:opacity-100 transition-opacity cursor-pointer" aria-label="Toggle theme">
        <svg class="w-3.5 h-3.5 dark-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <svg class="w-3.5 h-3.5 light-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>
    </div>
    
    <!-- Mobile Menu Button -->
    <button id="mobile-menu-toggle" class="header-bubble md:hidden flex flex-col items-center justify-center z-50 relative group rounded-full w-14 h-14 -mr-3 transition-all duration-500" aria-label="Menu">
      <div class="flower-container transition-all duration-700 ease-expo">
        <svg class="w-10 h-10 sakura-icon animate-spin-slow" viewBox="0 0 100 100" fill="currentColor">
          <path d="M50 50 Q35 25 45 15 L50 20 L55 15 Q65 25 50 50" class="petal"></path>
          <path d="M50 50 Q35 25 45 15 L50 20 L55 15 Q65 25 50 50" class="petal" transform="rotate(72 50 50)"></path>
          <path d="M50 50 Q35 25 45 15 L50 20 L55 15 Q65 25 50 50" class="petal" transform="rotate(144 50 50)"></path>
          <path d="M50 50 Q35 25 45 15 L50 20 L55 15 Q65 25 50 50" class="petal" transform="rotate(216 50 50)"></path>
          <path d="M50 50 Q35 25 45 15 L50 20 L55 15 Q65 25 50 50" class="petal" transform="rotate(288 50 50)"></path>
        </svg>
      </div>
      <div class="menu-label-container -translate-y-1 text-[7px] uppercase tracking-[0.2em] font-bold opacity-70 group-hover:opacity-100 transition-opacity text-center leading-none">
        <div class="menu-text">
          <span class="lang-en">Menu</span>
          <span class="lang-ja">メニュー</span>
        </div>
        <div class="close-text hidden">
          <span class="lang-en">Close</span>
          <span class="lang-ja">閉じる</span>
        </div>
      </div>
    </button>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 bg-theme z-40 translate-x-full transition-transform duration-500 ease-expo pointer-events-none overflow-y-auto">
    <div class="flex flex-col justify-start min-h-full p-6 sm:p-12 pt-24 sm:pt-32 pb-24 gap-6 sm:gap-8 text-3xl sm:text-4xl font-serif">
      {showNews && (
        <a href={base + "news"} class="mobile-link opacity-0 translate-y-4 transition-all duration-500 delay-100 cursor-pointer">
          <span class="lang-en">News</span>
          <span class="lang-ja">ニュース</span>
        </a>
      )}
      <a href={aboutHref} class="mobile-link opacity-0 translate-y-4 transition-all duration-500 delay-[150ms] cursor-pointer">
        <span class="lang-en">About</span>
        <span class="lang-ja">私たちについて</span>
      </a>
      <a href={projectsHref} class="mobile-link opacity-0 translate-y-4 transition-all duration-500 delay-[200ms] cursor-pointer">
        <span class="lang-en">Projects</span>
        <span class="lang-ja">プロジェクト</span>
      </a>
      <a href={contactHref} class="mobile-link opacity-0 translate-y-4 transition-all duration-500 delay-[250ms] cursor-pointer">
        <span class="lang-en">Contact</span>
        <span class="lang-ja">お問い合わせ</span>
      </a>
      {showJournal && (
        <a href={base + "journal"} class="mobile-link opacity-0 translate-y-4 transition-all duration-500 delay-[300ms] cursor-pointer">
          <span class="lang-en">Journal</span>
          <span class="lang-ja">ジャーナル</span>
        </a>
      )}
      
      <div class="mt-auto pt-12 opacity-0 translate-y-4 transition-all duration-500 delay-[350ms] mobile-controls">
        <!-- Theme Toggle -->
        <button id="mobile-theme-toggle" class="flex items-center gap-2.5 border border-current rounded-full px-5 sm:px-6 py-2.5 sm:py-3 hover:opacity-60 transition-opacity cursor-pointer" aria-label="Toggle theme">
          <!-- Sun Icon -->
          <svg class="w-5 h-5 theme-icon-sun transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <!-- Bidirectional Arrow -->
          <svg class="w-4 h-4 opacity-60" style="order: 2;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
          </svg>
          <!-- Moon Icon -->
          <svg class="w-5 h-5 theme-icon-moon transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>

        <!-- Language Toggle -->
        <div id="mobile-lang-toggle" class="mt-4 sm:mt-6 flex items-center gap-4 sm:gap-6 text-lg sm:text-xl font-bold tracking-widest">
          <button id="mobile-lang-en" class="hover:opacity-60 transition-opacity cursor-pointer">EN</button>
          <span class="opacity-30 text-xl sm:text-2xl">/</span>
          <button id="mobile-lang-ja" class="hover:opacity-60 transition-opacity cursor-pointer">日本語</button>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Theme toggle functionality
  const setupThemeToggle = (buttonId: string) => {
    const toggle = document.getElementById(buttonId);
    if (!toggle) return;
    
    const html = document.documentElement;
    const darkIcon = toggle.querySelector('.dark-icon');
    const lightIcon = toggle.querySelector('.light-icon');
    const sunIcon = toggle.querySelector('.theme-icon-sun');
    const moonIcon = toggle.querySelector('.theme-icon-moon');

    const updateIcons = () => {
      const isLight = html.getAttribute('data-theme') === 'light';
      
      // Only update icons if they exist (desktop version has toggling icons)
      if (darkIcon && lightIcon) {
        if (isLight) {
          darkIcon.classList.add('hidden');
          lightIcon.classList.remove('hidden');
        } else {
          darkIcon.classList.remove('hidden');
          lightIcon.classList.add('hidden');
        }
      }
      
      // Reorder sun/moon icons for mobile (current theme on left, next theme on right)
      if (sunIcon && moonIcon) {
        if (isLight) {
          // Light mode: Sun (current) on left, Moon (next) on right
          (sunIcon as HTMLElement).style.order = '1';
          (moonIcon as HTMLElement).style.order = '3';
        } else {
          // Dark mode: Moon (current) on left, Sun (next) on right
          (moonIcon as HTMLElement).style.order = '1';
          (sunIcon as HTMLElement).style.order = '3';
        }
      }
    };
    
    // Initial icon state
    updateIcons();

    // Listen for theme changes to update icons
    window.addEventListener('theme-changed', updateIcons);
    
    toggle.addEventListener('click', () => {
      const currentTheme = html.getAttribute('data-theme');
      const newTheme = currentTheme === 'light' ? 'dark' : 'light';
      
      // Dispatch transition event
      window.dispatchEvent(new CustomEvent('theme-transition', { 
        detail: { theme: newTheme } 
      }));
    });
  };

  setupThemeToggle('theme-toggle');
  setupThemeToggle('mobile-theme-toggle');

  // Language toggle functionality
  const setupLangToggle = (enId: string, jaId: string) => {
    const enBtn = document.getElementById(enId);
    const jaBtn = document.getElementById(jaId);
    const html = document.documentElement;

    const updateActiveState = () => {
      const currentLang = html.getAttribute('lang') || 'en';
      if (currentLang === 'en') {
        enBtn?.classList.add('opacity-100');
        enBtn?.classList.remove('opacity-40');
        jaBtn?.classList.add('opacity-40');
        jaBtn?.classList.remove('opacity-100');
      } else {
        jaBtn?.classList.add('opacity-100');
        jaBtn?.classList.remove('opacity-40');
        enBtn?.classList.add('opacity-40');
        enBtn?.classList.remove('opacity-100');
      }
    };

    const setLang = (lang: string) => {
      html.setAttribute('lang', lang);
      localStorage.setItem('lang', lang);
      updateActiveState();
      // Dispatch event for other components
      window.dispatchEvent(new CustomEvent('lang-changed', { detail: { lang } }));
    };

    enBtn?.addEventListener('click', () => setLang('en'));
    jaBtn?.addEventListener('click', () => setLang('ja'));
    
    // Initial state
    updateActiveState();
  };

  setupLangToggle('lang-en', 'lang-ja');
  setupLangToggle('mobile-lang-en', 'mobile-lang-ja');

  // Greeting logic
  const updateGreeting = () => {
    const greetingEl = document.getElementById('header-greeting');
    if (!greetingEl) return;

    const now = new Date();
    const hour = now.getHours();
    const lang = document.documentElement.getAttribute('lang') || 'en';

    let greeting = '';
    let emoji = '';

    if (hour >= 5 && hour < 12) {
      greeting = lang === 'ja' ? 'おはよう' : 'Good Morning';
      emoji = '☀️';
    } else if (hour >= 12 && hour < 18) {
      greeting = lang === 'ja' ? 'こんにちは' : 'Good Afternoon';
      emoji = '🌤️';
    } else {
      greeting = lang === 'ja' ? 'こんばんは' : 'Good Evening';
      emoji = '🌙';
    }

    // Fade out, change text, fade in
    greetingEl.classList.remove('opacity-100');
    greetingEl.classList.add('opacity-0');
    
    setTimeout(() => {
      greetingEl.innerHTML = `${greeting} <span class="ml-1">${emoji}</span>`;
      greetingEl.classList.remove('opacity-0');
      greetingEl.classList.add('opacity-100');
    }, 300);
  };

  // Initial greeting
  updateGreeting();

  // Update greeting on language change
  window.addEventListener('lang-changed', updateGreeting);

  // Header Swap Logic (Greeting vs Logo)
  const headerGreeting = document.getElementById('header-greeting');
  const headerLogo = document.getElementById('header-logo');
  const heroSection = document.querySelector('section'); // Target first section (Hero)

  const swapHeaderContent = (showGreeting: boolean) => {
    if (showGreeting) {
      headerGreeting?.classList.remove('opacity-0');
      headerGreeting?.classList.add('opacity-100');
      headerLogo?.classList.remove('opacity-100');
      headerLogo?.classList.add('opacity-0');
    } else {
      headerGreeting?.classList.remove('opacity-100');
      headerGreeting?.classList.add('opacity-0');
      headerLogo?.classList.remove('opacity-0');
      headerLogo?.classList.add('opacity-100');
    }
  };

  if (heroSection && headerGreeting && headerLogo) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        swapHeaderContent(entry.isIntersecting);
      });
    }, { threshold: 0.1 });

    observer.observe(heroSection);
  } else {
    // If no hero section (other routes), show logo immediately
    swapHeaderContent(false);
  }

  // Mobile Menu Functionality
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  let isMenuOpen = false;

  const toggleMenu = () => {
    isMenuOpen = !isMenuOpen;
    
    // Toggle menu visibility
    menu?.classList.toggle('translate-x-full', !isMenuOpen);
    menu?.classList.toggle('pointer-events-none', !isMenuOpen);
    
    // Animate Sakura
    const flower = menuToggle?.querySelector('.flower-container');
    if (flower instanceof HTMLElement) {
      flower.style.transform = isMenuOpen ? 'rotate(180deg) scale(1.1)' : '';
    }

    // Toggle Menu/Close text
    const menuText = menuToggle?.querySelector('.menu-text');
    const closeText = menuToggle?.querySelector('.close-text');
    if (menuText && closeText) {
      menuText.classList.toggle('hidden', isMenuOpen);
      closeText.classList.toggle('hidden', !isMenuOpen);
    }

    // Animate Links
    mobileLinks.forEach(link => {
      link.classList.toggle('opacity-100', isMenuOpen);
      link.classList.toggle('translate-y-0', isMenuOpen);
    });

    // Animate Controls
    const mobileControls = document.querySelector('.mobile-controls');
    if (mobileControls) {
      mobileControls.classList.toggle('opacity-100', isMenuOpen);
      mobileControls.classList.toggle('translate-y-0', isMenuOpen);
    }

    document.body.style.overflow = isMenuOpen ? 'hidden' : '';
  };

  menuToggle?.addEventListener('click', toggleMenu);
  mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));
</script>

<style>
  header {
    font-family: var(--font-sans);
  }
  
  header > nav > a:first-child {
    font-family: var(--font-serif);
  }

  .ease-expo {
    transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  }
  
  /* Bubble backgrounds - hidden by default */
  .header-bubble {
    background-color: transparent;
    backdrop-filter: none;
  }
  
  /* Show bubble backgrounds when scrolled */
  header.scrolled .header-bubble {
    background-color: var(--color-bg);
    backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
  }
  
  /* Light mode adjustments */
  :root[data-theme="light"] header.scrolled .header-bubble {
    background-color: rgba(255, 255, 255, 0.85);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
  }
  
  /* Dark mode adjustments */
  :root:not([data-theme="light"]) header.scrolled .header-bubble {
    background-color: rgba(0, 0, 0, 0.75);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  /* Sakura Flower Color in Light Mode */
  :root[data-theme="light"] .sakura-icon {
    color: #FFB7C5; /* Bright Light Sakura Pink */
  }

  .animate-spin-slow {
    animation: spin 12s linear infinite;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes butterfly-mini-flap {
    0% { transform: scaleX(1); opacity: 0.3; }
    50% { transform: scaleX(0.4); opacity: 0.6; }
    100% { transform: scaleX(1); opacity: 0.3; }
  }

  .animate-butterfly-mini {
    animation: butterfly-mini-flap 0.8s infinite ease-in-out;
    transform-origin: center;
  }
</style>

<script is:inline>
  // Add scrolled class to header when past hero
  document.addEventListener('DOMContentLoaded', () => {
    const mainHeader = document.getElementById('main-header');
    const heroSection = document.getElementById('hero');
    let heroHeight = 0;
    
    const updateHeroHeight = () => {
      if (heroSection) {
        heroHeight = heroSection.offsetHeight;
      } else {
        heroHeight = 0;
      }
    };
    
    // Initial and resize updates for height
    updateHeroHeight();
    window.addEventListener('resize', updateHeroHeight, { passive: true });
    
    let ticking = false;
    
    const checkScroll = () => {
      if (!mainHeader) return;
      
      // Get scroll position from multiple sources
      const fullpageWrapper = document.getElementById('fullpage-wrapper');
      const wrapperScroll = fullpageWrapper ? fullpageWrapper.scrollTop : 0;
      const windowScroll = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop;
      
      // Use whichever has a value (mobile uses window, desktop uses wrapper)
      const scrollTop = Math.max(wrapperScroll, windowScroll);
      
      const threshold = heroHeight > 0 ? heroHeight - 100 : 100;
      
      if (scrollTop > threshold) {
        if (!mainHeader.classList.contains('scrolled')) {
          mainHeader.classList.add('scrolled');
        }
      } else {
         if (mainHeader.classList.contains('scrolled')) {
          mainHeader.classList.remove('scrolled');
        }
      }
      
      ticking = false;
    };
    
    const requestTick = () => {
      if (!ticking) {
        requestAnimationFrame(checkScroll);
        ticking = true;
      }
    };
    
    // Listen to window scroll
    window.addEventListener('scroll', requestTick, { passive: true });
    document.body.addEventListener('scroll', requestTick, { passive: true });
    
    // Listen to fullpage wrapper scroll if it exists
    const fullpageWrapper = document.getElementById('fullpage-wrapper');
    if (fullpageWrapper) {
      fullpageWrapper.addEventListener('scroll', requestTick, { passive: true });
    }
    
    // Initial check
    checkScroll();
  });
</script>
