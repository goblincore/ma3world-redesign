---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div id="fullpage-wrapper" class={`fullpage-wrapper ${className}`}>
  <slot />
</div>

<style>
  .fullpage-wrapper {
    width: 100%;
    overflow-x: hidden;
  }
  
  /* Shared styles for sections */
  .fullpage-wrapper > :global(section),
  .fullpage-wrapper > :global(footer) {
    width: 100%;
    position: relative;
    /* Maintain min-height for the "slide" feel without locking */
    min-height: 100vh;
    height: auto;
  }
  
  /* Sections with no-snap class can be smaller if needed */
  .fullpage-wrapper > :global(section.no-snap) {
    min-height: auto;
  }
</style>

<script>
  // Expose sections for other components if needed
  const sections = ['hero', 'about', 'projects', 'contact'];
  let currentSlide = 0;
  
  // Cache section positions
  /** @type {{ id: string, top: number, height: number }[]} */
  let sectionPositions = [];

  const updateSectionPositions = () => {
    sectionPositions = sections.map(id => {
      const el = document.getElementById(id);
      if (!el) return null;
      const rect = el.getBoundingClientRect();
      // Calculate absolute top position relative to document
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const top = rect.top + scrollTop;
      return { id, top, height: rect.height };
    }).filter(Boolean);
  };

  // Initial and resize updates
  updateSectionPositions();
  window.addEventListener('resize', updateSectionPositions, { passive: true });
  
  const goToSlide = (index: number) => {
    if (index < 0 || index >= sections.length) return;
    currentSlide = index;
    
    const el = document.getElementById(sections[index]);
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    
    window.dispatchEvent(new CustomEvent('section-changed', { detail: { index } }));
  };
  
  // @ts-ignore - expose globally
  window.goToSlide = goToSlide;
  
  // Track scroll position
  let ticking = false;
  
  const checkScroll = () => {
    // Get current scroll position
    const scrollTop = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop;
    
    let closestIndex = 0;
    let minDiff = Infinity;
    
    // Use cached positions
    sectionPositions.forEach((pos, i) => {
      // Distance from current scroll top to section top
      // We want the section that is closest to the top of the viewport
      const diff = Math.abs(pos.top - scrollTop);
      
      if (diff < minDiff) {
        minDiff = diff;
        closestIndex = i;
      }
    });
    
    // Special case: if we're at the very bottom, highlight the last section
    const scrollBottom = scrollTop + window.innerHeight;
    const documentHeight = document.documentElement.scrollHeight;
    if (Math.abs(documentHeight - scrollBottom) < 50) {
      closestIndex = sections.length - 1;
    }
    
    if (closestIndex !== currentSlide) {
      currentSlide = closestIndex;
      window.dispatchEvent(new CustomEvent('section-changed', { detail: { index: currentSlide } }));
    }
    
    ticking = false;
  };
  
  const requestTick = () => {
    if (!ticking) {
      requestAnimationFrame(checkScroll);
      ticking = true;
    }
  };
  
  window.addEventListener('scroll', requestTick, { passive: true });
  
  // Initial state check
  setTimeout(() => {
    updateSectionPositions();
    checkScroll();
  }, 100);
</script>
