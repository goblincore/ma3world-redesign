---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div id="fullpage-wrapper" class={`fullpage-wrapper ${className}`}>
  <slot />
</div>

<style>
  .fullpage-wrapper {
    width: 100%;
    overflow-x: hidden;
  }
  
  /* Shared styles for sections */
  .fullpage-wrapper > :global(section),
  .fullpage-wrapper > :global(footer) {
    width: 100%;
    position: relative;
    /* Maintain min-height for the "slide" feel without locking */
    min-height: 100vh;
    height: auto;
  }
  
  /* Sections with no-snap class can be smaller if needed */
  .fullpage-wrapper > :global(section.no-snap) {
    min-height: auto;
  }
</style>

<script>
  // Expose sections for other components if needed
  const sections = ['hero', 'about', 'projects', 'contact'];
  let currentSlide = 0;
  
  const goToSlide = (index: number) => {
    if (index < 0 || index >= sections.length) return;
    currentSlide = index;
    
    const el = document.getElementById(sections[index]);
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    
    window.dispatchEvent(new CustomEvent('section-changed', { detail: { index } }));
  };
  
  // @ts-ignore - expose globally
  window.goToSlide = goToSlide;
  
  // Track scroll position
  let scrollTimeout: ReturnType<typeof setTimeout>;
  
  const handleScroll = () => {
    clearTimeout(scrollTimeout);
    scrollTimeout = setTimeout(() => {
      // Use window.scrollY for natural scrolling
      let closestIndex = 0;
      let minDiff = Infinity;
      
      sections.forEach((id, i) => {
        const el = document.getElementById(id);
        if (!el) return;
        
        // Calculate distance from top of viewport
        const rect = el.getBoundingClientRect();
        const diff = Math.abs(rect.top);
        
        if (diff < minDiff) {
          minDiff = diff;
          closestIndex = i;
        }
      });
      
      // Special case: if we're at the very bottom, highlight the last section (usually footer/contact)
      const scrollBottom = window.scrollY + window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      if (Math.abs(documentHeight - scrollBottom) < 50) {
        closestIndex = sections.length - 1;
      }
      
      if (closestIndex !== currentSlide) {
        currentSlide = closestIndex;
        window.dispatchEvent(new CustomEvent('section-changed', { detail: { index: currentSlide } }));
      }
    }, 50); // Faster debounce for smoother updates
  };
  
  window.addEventListener('scroll', handleScroll, { passive: true });
  
  // Initial state check
  setTimeout(() => {
    handleScroll();
  }, 100);
</script>
