---
import LegalModal from './LegalModal.astro';

interface Props {
  showNews?: boolean;
  showJournal?: boolean;
}

const { 
  showNews = true, 
  showJournal = true 
} = Astro.props;

const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;

const navLinks = [
  ...(showNews ? [{ name: "News", nameJa: "ニュース", url: base + "news" }] : []),
  { name: "Projects", nameJa: "実績", url: base + "#projects" },
  { name: "About", nameJa: "私たちについて", url: base + "#about" },
  { name: "Clients", nameJa: "クライアント", url: base + "#clients" },
  { name: "Contact", nameJa: "お問い合わせ", url: base + "#contact" },
  ...(showJournal ? [{ name: "Journal", nameJa: "ジャーナル", url: base + "journal" }] : []),
];

const CMS_URL = import.meta.env.CMS_URL || 'http://localhost:3001';
---

<footer id="contact" class="bg-theme py-16 md:py-24 lg:py-32 px-6 md:px-12 flex items-center justify-center">
  <div class="max-w-7xl w-full">
    <!-- Top Section -->
    <div class="grid md:grid-cols-2 gap-16 md:gap-24 mb-24">
      <!-- CTA -->
      <div>
        <h2 class="font-serif text-4xl md:text-6xl mb-8">
          <span class="lang-en">Let's create<br/>something together</span>
          <span class="lang-ja">共に、新しい価値を<br/>創り上げましょう</span>
        </h2>
        <div class="flex flex-col items-start gap-6">
          <a href="mailto:info@ma3world.com" class="inline-block text-2xl md:text-3xl hover:opacity-60 transition-opacity border-b border-white/20 pb-2">
            info@ma3world.com
          </a>
          <a href="https://www.instagram.com/ma3.world/" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 text-lg hover:opacity-100 transition-all opacity-70">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span class="tracking-widest uppercase text-xs font-bold">@ma3.world</span>
          </a>
        </div>
      </div>
      
      <!-- Contact Form -->
      <div class="w-full">
        <form id="contact-form" class="flex flex-col gap-6">
          <div class="flex flex-col gap-2">
            <label for="name" class="text-[10px] uppercase tracking-[0.2em] font-bold text-theme-muted">
              <span class="lang-en">Name</span>
              <span class="lang-ja">お名前</span>
            </label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required
              placeholder="Your Name / お名前"
              class="w-full bg-transparent border-b border-theme/50 px-4 py-3 focus:border-theme outline-none transition-colors text-lg placeholder:text-theme-muted/50"
            />
          </div>
          
          <div class="flex flex-col gap-2">
            <label for="email" class="text-[10px] uppercase tracking-[0.2em] font-bold text-theme-muted">
              <span class="lang-en">Email</span>
              <span class="lang-ja">メールアドレス</span>
            </label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required
              placeholder="hello@example.com"
              class="w-full bg-transparent border-b border-theme/50 px-4 py-3 focus:border-theme outline-none transition-colors text-lg placeholder:text-theme-muted/50"
            />
          </div>
          
          <div class="flex flex-col gap-2">
            <label for="message" class="text-[10px] uppercase tracking-[0.2em] font-bold text-theme-muted">
              <span class="lang-en">Message</span>
              <span class="lang-ja">メッセージ</span>
            </label>
            <textarea 
              id="message" 
              name="message" 
              required
              rows="4" 
              placeholder="Tell us about your project..."
              class="w-full bg-transparent border border-theme/50 p-4 focus:border-theme outline-none transition-colors text-lg resize-none placeholder:text-theme-muted/50"
            ></textarea>
          </div>
          
          <div id="form-message" class="hidden text-sm py-2 px-4 rounded-sm animate-fade-in"></div>

          <button type="submit" id="submit-btn" class="group mt-8 flex items-center gap-3 bg-theme text-theme border border-current py-4 px-10 self-start font-bold uppercase tracking-[0.2em] text-[10px] hover:bg-theme-alt transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer">
            <svg class="w-5 h-5 transition-all group-hover:scale-110" viewBox="0 0 100 100" fill="currentColor">
              <!-- Antennae -->
              <path d="M50 34 Q50 20 40 15 M50 34 Q50 20 60 15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              <!-- Wings Group -->
              <g class="origin-center butterfly-wings">
                <!-- Left Wings -->
                <path d="M50 50 C25 20 5 35 15 55 C20 70 45 65 50 60 C45 70 25 90 15 80 C5 70 25 50 50 55" />
                <!-- Right Wings -->
                <path d="M50 50 C75 20 95 35 85 55 C80 70 55 65 50 60 C55 70 75 90 85 80 C95 70 75 50 50 55" />
              </g>
              <!-- Body -->
              <path d="M48 35 L52 35 L52 70 L48 70 Z" />
            </svg>
            <span class="submit-text lang-en">Send Message</span>
            <span class="submit-text lang-ja">送信する</span>
            <span class="loading-text hidden">
              <span class="lang-en">Sending...</span>
              <span class="lang-ja">送信中...</span>
            </span>
          </button>
        </form>
      </div>
    </div>
    
    <!-- Bottom Section -->
    <div class="pt-8 border-t border-theme">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-8">
        <!-- Copyright -->
        <p class="text-sm text-theme-muted">
          <span class="lang-en">© {currentYear} MA3world Inc. All rights reserved.</span>
          <span class="lang-ja">© {currentYear} MA3world Inc. 無断複写・転載を禁じます。</span>
        </p>
      </div>

      <!-- Fine Print -->
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 text-[9px] uppercase tracking-[0.2em] text-theme-muted/30">
        <div class="flex gap-6">
          <button id="open-terms" class="hover:text-theme transition-colors cursor-pointer">
            <span class="lang-en">Terms</span>
            <span class="lang-ja">利用規約</span>
          </button>
          <button id="open-privacy" class="hover:text-theme transition-colors cursor-pointer text-left">
            <span class="lang-en">Privacy Policy</span>
            <span class="lang-ja">プライバシーポリシー</span>
          </button>
        </div>
        <a href="https://jonnydont.surf" target="_blank" rel="noopener noreferrer" class="hover:text-theme transition-colors">
          Site design and implementation by jonnydont.surf
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  h2, .font-serif {
    font-family: var(--font-serif);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Robust theme-aware placeholders */
  input::placeholder,
  textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.5;
    transition: color 0.3s ease;
  }

  @keyframes butterfly-flap {
    0% { transform: scaleX(1); }
    50% { transform: scaleX(0.3); }
    100% { transform: scaleX(1); }
  }

  .group:hover .butterfly-wings {
    animation: butterfly-flap 0.25s infinite ease-in-out;
  }

  /* Fix autofill background */
  input:-webkit-autofill,
  input:-webkit-autofill:hover, 
  input:-webkit-autofill:focus,
  textarea:-webkit-autofill,
  textarea:-webkit-autofill:hover,
  textarea:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--color-text);
    -webkit-box-shadow: 0 0 0px 1000px var(--color-bg) inset;
    transition: background-color 5000s ease-in-out 0s;
  }

  :root[data-theme="light"] input:-webkit-autofill,
  :root[data-theme="light"] textarea:-webkit-autofill {
    -webkit-box-shadow: 0 0 0px 1000px white inset;
  }
</style>

<script is:inline define:vars={{ CMS_URL }}>
  const contactForm = document.getElementById('contact-form');
  const formMessage = document.getElementById('form-message');
  const submitBtn = document.getElementById('submit-btn');
  const submitTexts = submitBtn.querySelectorAll('.submit-text');
  const loadingText = submitBtn.querySelector('.loading-text');

  // CMS URL is injected via define:vars

  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(contactForm);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        message: formData.get('message'),
        source: window.location.pathname,
      };

      // Reset UI state
      formMessage.classList.add('hidden');
      formMessage.textContent = '';
      submitBtn.disabled = true;
      submitTexts.forEach(t => t.classList.add('hidden'));
      loadingText.classList.remove('hidden');

      try {
        const baseUrl = CMS_URL.endsWith('/') ? CMS_URL.slice(0, -1) : CMS_URL;
        const response = await fetch(`${baseUrl}/api/submissions`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          formMessage.classList.remove('hidden');
          formMessage.className = 'text-green-500 font-bold uppercase tracking-widest text-[10px] py-4 px-0 bg-transparent animate-fade-in';
          formMessage.textContent = document.documentElement.lang === 'ja' ? 'メッセージが正常に送信されました。' : 'Message sent successfully.';
          contactForm.reset();
        } else {
          throw new Error('Failed to send message');
        }
      } catch (error) {
        console.error('Contact form error:', error);
        formMessage.classList.remove('hidden');
        formMessage.className = 'text-red-500 font-bold uppercase tracking-widest text-[10px] py-4 px-0 bg-transparent animate-fade-in';
        formMessage.textContent = document.documentElement.lang === 'ja' ? 'エラーが発生しました。後でもう一度お試しください。' : 'An error occurred. Please try again later.';
      } finally {
        submitBtn.disabled = false;
        submitTexts.forEach(t => t.classList.remove('hidden'));
        loadingText.classList.add('hidden');
      }
    });
  }

  // Legal Modals Setup
  document.getElementById('open-terms')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-modal', { detail: { id: 'modal-terms' } }));
  });

  document.getElementById('open-privacy')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-modal', { detail: { id: 'modal-privacy' } }));
  });
</script>

<LegalModal id="modal-terms" titleEn="Terms of Service" titleJa="利用規約">
  <div class="space-y-6">
    <section>
      <h4 class="text-lg font-serif mb-2">1. Acceptance of Terms</h4>
      <p class="text-[14px] leading-relaxed opacity-70">By accessing and using this website, you accept and agree to be bound by the terms and provision of this agreement.</p>
      <p class="opacity-50 text-[11px] mt-2 font-ja">当ウェブサイトをご利用になることで、本規約に同意したものとみなされます。</p>
    </section>
    <section>
      <h4 class="text-lg font-serif mb-2">2. Intellectual Property</h4>
      <p class="text-[14px] leading-relaxed opacity-70">All content including logos, text, and media on this site are the property of MA3world Inc. and are protected by international copyright laws.</p>
      <p class="opacity-50 text-[11px] mt-2 font-ja">ロゴ、テキスト、メディアを含む当サイトのすべてのコンテンツはMA3world Inc.の所有物であり、国際著作権法によって保護されています。</p>
    </section>
    <section>
      <h4 class="text-lg font-serif mb-2">3. User Conduct</h4>
      <p class="text-[14px] leading-relaxed opacity-70">Users agree not to use the website for any unlawful purposes or to interfere with the operation of the site in any way.</p>
      <p class="opacity-50 text-[11px] mt-2 font-ja">利用者は、違法な目的で、あるいはサイトの運営を妨害するような形で当ウェブサイトを利用しないことに同意するものとします。</p>
    </section>
    <section>
      <h4 class="text-lg font-serif mb-2">4. Limitation of Liability</h4>
      <p class="text-[14px] leading-relaxed opacity-70">MA3world Inc. shall not be liable for any indirect, incidental, or consequential damages resulting from the use or inability to use the site.</p>
      <p class="opacity-50 text-[11px] mt-2 font-ja">MA3world Inc.は、当サイトの利用または利用不能から生じるいかなる間接的、付随的、または結果的な損害についても責任を負いません。</p>
    </section>
  </div>
</LegalModal>

<LegalModal id="modal-privacy" titleEn="Privacy Policy" titleJa="プライバシーポリシー">
  <div class="space-y-6">
    <section>
      <h4 class="text-lg font-serif mb-2">1. Information Collection</h4>
      <p class="text-[14px] leading-relaxed opacity-70">We collect information that you provide to us directly via our contact form, including your name and email address.</p>
      <p class="opacity-50 text-[11px] mt-2 font-ja">お問い合わせフォームを通じて直接提供される氏名やメールアドレスなどの情報を収集します。</p>
    </section>
    <section>
      <h4 class="text-lg font-serif mb-2">2. Use of Information</h4>
      <p class="text-[14px] leading-relaxed opacity-70">The information we collect is used solely to respond to your inquiries and to provide better services to our clients.</p>
      <p class="opacity-50 text-[11px] mt-2 font-ja">収集した情報は、お問い合わせへの回答や利用者へのより良いサービスの提供にのみ使用されます。</p>
    </section>
    <section>
      <h4 class="text-lg font-serif mb-2">3. Data Protection</h4>
      <p class="text-[14px] leading-relaxed opacity-70">We implement a variety of security measures to maintain the safety of your personal information when you enter, submit, or access your personal information.</p>
      <p class="opacity-50 text-[11px] mt-2 font-ja">個人情報の入力、送信、アクセスが行われる際、その安全性を維持するために様々なセキュリティ対策を実施しています。</p>
    </section>
    <section>
      <h4 class="text-lg font-serif mb-2">4. Cookies</h4>
      <p class="text-[14px] leading-relaxed opacity-70">We may use cookies to understand and save your preferences for future visits and compile aggregate data about site traffic.</p>
      <p class="opacity-50 text-[11px] mt-2 font-ja">将来の訪問時の設定を理解して保存し、サイトトラフィックに関する集計データを収集するためにクッキーを使用する場合があります。</p>
    </section>
  </div>
</LegalModal>
