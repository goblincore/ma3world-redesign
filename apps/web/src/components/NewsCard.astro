---
interface Props {
  title: string;
  titleJa?: string;
  date: string;
  dateJa?: string;
  image?: string;
  description: string;
  descriptionJa?: string;
  href: string;
  category?: string;
}

const { title, titleJa, date, dateJa, image, description, descriptionJa, href, category = "NEWS" } = Astro.props;
---

<a href={href} class="group block space-y-4">
  <div class="relative aspect-[16/10] overflow-hidden bg-theme-muted rounded-sm">
    {image ? (
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center relative bg-theme-muted group-hover:bg-theme-alt/10 transition-colors duration-700">
        <img 
          src="/ma3world-redesign/news-placeholder-light-v2.png" 
          alt="News placeholder" 
          class="relative z-10 w-40 h-40 md:w-56 md:h-56 object-contain light-placeholder transition-all duration-700 group-hover:scale-105 opacity-15 group-hover:opacity-30"
          style="mix-blend-mode: multiply;"
        />
        <img 
          src="/ma3world-redesign/news-placeholder-dark-v2.png" 
          alt="News placeholder" 
          class="relative z-10 w-40 h-40 md:w-56 md:h-56 object-contain dark-placeholder hidden transition-all duration-700 group-hover:scale-105 opacity-30 group-hover:opacity-60"
          style="mix-blend-mode: screen;"
        />
      </div>
    )}
  </div>
  
  <div class="space-y-3">
    <div class="flex items-center gap-4 text-[10px] uppercase tracking-[0.2em] font-bold opacity-50">
      <span class="lang-en">{date}</span>
      <span class="lang-ja">{dateJa || date}</span>
      <span class="w-1 h-1 bg-current rounded-full"></span>
      <span class="lang-en">MA3 Press</span>
      <span class="lang-ja">MA3 プレス</span>
    </div>
    
    <h2 class="text-xl md:text-2xl font-serif leading-tight group-hover:text-theme-muted transition-colors">
      <span class="lang-en" set:html={title} />
      <span class="lang-ja" set:html={titleJa || title} />
    </h2>
    
    <div class="text-sm leading-relaxed opacity-60 line-clamp-2">
      <p class="lang-en">{description}</p>
      <p class="lang-ja">{descriptionJa || description}</p>
    </div>
    
    <div class="pt-2 flex items-center gap-2 text-[10px] uppercase tracking-[0.3em] font-bold group-hover:gap-4 transition-all">
      <span class="lang-en">Read Post</span>
      <span class="lang-ja">記事を読む</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </div>
  </div>
</a>
