---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RichTextRenderer from '../../components/RichTextRenderer.astro';
import EmptyJournalState from '../../components/EmptyJournalState.astro';
import { getJournal, getMediaUrl, getCmsUrl, getSettings, type Journal } from '../../lib/cms';

export async function getStaticPaths({ paginate }) {
  // Fetch both English and Japanese versions to support toggling
  const [journalEn, journalJa] = await Promise.all([
    getJournal('en'),
    getJournal('ja')
  ]);

  // Zip them by slug/id to have both translations available on the same page
  const combined = journalEn.map((enItem: Journal) => {
    const jaItem = journalJa.find(ja => ja.slug === enItem.slug) || enItem;
    return {
      en: enItem,
      ja: jaItem,
      date: new Date(enItem.date)
    };
  }).sort((a, b) => b.date.getTime() - a.date.getTime());

  return paginate(combined, { pageSize: 10 });
}

const { page } = Astro.props;
const settings = await getSettings();
const showNews = settings?.showNews ?? true;
const showJournal = settings?.showJournal ?? true;

const base = import.meta.env.BASE_URL;

function formatDate(dateString: string) {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title="Journal | MA3.0 World">
  <Header showNews={showNews} showJournal={showJournal} />
  <main class="bg-theme pt-32 pb-32 px-6 md:px-12 min-h-screen">
    <div class="max-w-3xl mx-auto">
      <header class="mb-20">
        <span class="text-[10px] uppercase tracking-[0.4em] font-bold opacity-50 block mb-4">
          <span class="lang-en">Reflections & Thoughts</span>
          <span class="lang-ja">思考と反省</span>
        </span>
        <h1 class="text-5xl md:text-7xl font-serif mb-6">
          <span class="lang-en">Journal</span>
          <span class="lang-ja">ジャーナル</span>
        </h1>
        <p class="text-lg opacity-60 leading-relaxed max-w-2xl">
          <span class="lang-en">A more casual space for sharing our process, experiments, and daily discoveries in the world of cultural innovation.</span>
          <span class="lang-ja">文化的イノベーションの世界における私たちのプロセス、実験、そして日々の発見を共有する、よりカジュアルなスペースです。</span>
        </p>
      </header>

      {page.data.length > 0 ? (
        <div class="space-y-32">
          {page.data.map((item: any) => (
            <article class="group">
              <header class="mb-12">
                <div class="flex items-center gap-4 text-[10px] uppercase tracking-[0.2em] font-bold opacity-50 mb-4">
                  <time datetime={item.en.date}>
                    <span class="lang-en">{new Date(item.en.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                    <span class="lang-ja">{new Date(item.en.date).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                  </time>
                  <span class="w-1 h-1 bg-current rounded-full"></span>
                  <span class="lang-en">MA3.0 Journal</span>
                  <span class="lang-ja">MA3.0 ジャーナル</span>
                </div>
                <h2 class="text-3xl md:text-5xl font-serif mb-6 leading-tight">
                  <span class="lang-en">{item.en.title}</span>
                  <span class="lang-ja">{item.ja.title}</span>
                </h2>
              </header>

              {getMediaUrl(item.en.image, { width: 1200 }) && (
                <div class="bg-theme-alt rounded-sm mb-12 flex justify-center overflow-hidden">
                  <img 
                    src={getMediaUrl(item.en.image, { width: 1200 })!} 
                    alt={item.en.title} 
                    class="max-w-full h-auto max-h-[85vh] object-contain transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}

              <div class="text-lg leading-relaxed text-theme-muted mb-12 opacity-80">
                <div class="lang-en"><p>{item.en.description}</p></div>
                <div class="lang-ja"><p>{item.ja.description}</p></div>
              </div>

              {item.en.content && (
                <div class="prose prose-lg dark:prose-invert max-w-none text-theme mb-12 journal-content">
                  <div class="lang-en">
                    <RichTextRenderer node={item.en.content.root} />
                  </div>
                  {item.ja.content && (
                    <div class="lang-ja">
                      <RichTextRenderer node={item.ja.content.root} />
                    </div>
                  )}
                </div>
              )}

              <footer class="pt-8 border-t border-theme-alt/10">
                <div class="flex items-center justify-between gap-4 flex-wrap">
                  {item.en.tags && item.en.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 text-[10px] uppercase tracking-[0.2em] font-bold">
                      <span class="opacity-30 mr-2">
                        <span class="lang-en">Tags:</span>
                        <span class="lang-ja">タグ:</span>
                      </span>
                      {item.en.tags.map((tag: any) => (
                        <span class="opacity-60 hover:opacity-100 transition-opacity cursor-default">
                          #{tag.name || tag}
                        </span>
                      ))}
                    </div>
                  )}
                  
                  <a 
                    href={`${base}journal/${item.en.slug}`} 
                    class="text-[10px] uppercase tracking-[0.2em] font-bold opacity-40 hover:opacity-100 transition-opacity flex items-center gap-2 group"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60">
                      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                    <span class="lang-en">Permalink</span>
                    <span class="lang-ja">パーマリンク</span>
                  </a>
                </div>
              </footer>
            </article>
          ))}

          {/* Pagination */}
          {(page.url.prev || page.url.next) && (
            <nav class="pt-20 border-t border-theme-alt/20 flex items-center justify-between">
              {page.url.prev ? (
                <a href={page.url.prev} class="flex items-center gap-4 text-sm font-bold uppercase tracking-widest opacity-60 hover:opacity-100 transition-opacity">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="rotate-180">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                  <span class="lang-en">Newer Posts</span>
                  <span class="lang-ja">新しい投稿</span>
                </a>
              ) : <div />}

              {page.url.next ? (
                <a href={page.url.next} class="flex items-center gap-4 text-sm font-bold uppercase tracking-widest opacity-60 hover:opacity-100 transition-opacity">
                  <span class="lang-en">Older Posts</span>
                  <span class="lang-ja">過去の投稿</span>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
              ) : <div />}
            </nav>
          )}
        </div>
      ) : (
        <EmptyJournalState />
      )}
    </div>
  </main>
  <Footer showNews={showNews} showJournal={showJournal} />
</Layout>

<style>
  article {
    animation: fadeIn 0.8s ease-out forwards;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Portrait Image Fix */
  :global(.journal-content img) {
    display: block !important;
    margin-left: auto !important;
    margin-right: auto !important;
    max-height: 85vh !important;
    width: auto !important;
    max-width: 100% !important;
    object-fit: contain !important;
    border-radius: 0.125rem;
  }

  :global(.journal-content .aspect-video) {
    max-width: 900px !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }
</style>
