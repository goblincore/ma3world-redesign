---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getJournal, getMediaUrl, getCmsUrl, getSettings, type Journal } from '../../lib/cms';

// Fetch from CMS
const cmsJournal = await getJournal('en');
const cmsUrl = getCmsUrl();

const settings = await getSettings();
const showNews = settings?.showNews ?? true;
const showJournal = settings?.showJournal ?? true;

// Transform CMS data
const journalItems = cmsJournal.length > 0 
  ? cmsJournal.map((item: Journal) => {
      const imageUrl = getMediaUrl(item.image);
      return {
        title: item.title,
        date: new Date(item.date).toLocaleDateString('en-CA').replace(/-/g, '/'),
        image: imageUrl || undefined,
        description: item.description,
        href: `/journal/${item.slug}`,
        originalDate: new Date(item.date)
      };
    }).sort((a, b) => b.originalDate.getTime() - a.originalDate.getTime())
  : [];

const featuredPost = journalItems[0];
const pastPosts = journalItems.slice(1);

const base = import.meta.env.BASE_URL;
const assetBase = import.meta.env.PROD ? 'https://ma3worldbunny.b-cdn.net/' : base;
---

<Layout title="Journal | MA3.0 World">
  <Header showNews={showNews} showJournal={showJournal} />
  <main class="bg-theme pt-32 pb-32 px-6 md:px-12 min-h-screen">
    <div class="max-w-7xl mx-auto">
      <header class="mb-20 max-w-4xl">
        <span class="text-[10px] uppercase tracking-[0.4em] font-bold opacity-50 block mb-4">Reflections & Thoughts</span>
        <h1 class="text-5xl md:text-7xl font-serif mb-6">
          <span class="lang-en">Journal</span>
          <span class="lang-ja">ジャーナル</span>
        </h1>
        <p class="text-lg opacity-60 leading-relaxed md:max-w-2xl">
          <span class="lang-en">A more casual space for sharing our process, experiments, and daily discoveries in the world of cultural innovation.</span>
          <span class="lang-ja">文化的イノベーションの世界における私たちのプロセス、実験、そして日々の発見を共有する、よりカジュアルなスペースです。</span>
        </p>
      </header>

      {featuredPost && (
        <section class="mb-24">
          <a href={featuredPost.href.startsWith('/') ? `${base}${featuredPost.href.slice(1)}` : featuredPost.href} class="group block relative overflow-hidden rounded-lg aspect-[16/9] md:aspect-[21/9]">
            {featuredPost.image && (
              <img 
                src={featuredPost.image.startsWith('http') ? featuredPost.image : (featuredPost.image.startsWith('/') ? `${assetBase}${featuredPost.image.slice(1)}` : featuredPost.image)} 
                alt={featuredPost.title}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-8 md:p-12 w-full">
              <span class="text-xs font-bold tracking-widest text-white/60 mb-4 block uppercase leading-none">{featuredPost.date} — Latest Post</span>
              <h2 class="text-3xl md:text-5xl font-serif text-white mb-4 group-hover:opacity-80 transition-opacity">{featuredPost.title}</h2>
              <p class="text-white/70 text-lg max-w-2xl line-clamp-2">{featuredPost.description}</p>
            </div>
          </a>
        </section>
      )}
      
      {pastPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
          {pastPosts.map(item => (
            <NewsCard 
              {...item} 
              href={item.href.startsWith('/') ? `${base}${item.href.slice(1)}` : item.href}
              image={item.image ? (item.image.startsWith('http') ? item.image : (item.image.startsWith('/') ? `${assetBase}${item.image.slice(1)}` : item.image)) : undefined}
            />
          ))}
        </div>
      ) : (
        !featuredPost && (
          <div class="text-center py-20 opacity-40">
            <p class="text-xl">No journal entries found.</p>
          </div>
        )
      )}
    </div>
  </main>
  <Footer showNews={showNews} showJournal={showJournal} />
</Layout>
