---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RichTextRenderer from '../../components/RichTextRenderer.astro';
import { getJournal, getJournalBySlug, getMediaUrl, getCmsUrl, getSettings, type Journal } from '../../lib/cms';

export async function getStaticPaths() {
  // Fetch all journal items from CMS
  const journalItems = await getJournal('en');
  
  // Generate paths for all journal items
  const paths = journalItems.map((item: Journal) => ({
    params: { slug: item.slug },
    props: { journalItem: item },
  }));
  
  return paths;
}

interface Props {
  journalItem?: Journal;
}

const { slug } = Astro.params;
const { journalItem: staticItem } = Astro.props;

// Fetch both English and Japanese versions
let itemEn: Journal | undefined;
let itemJa: Journal | undefined;

if (slug) {
  const [fetchedEn, fetchedJa] = await Promise.all([
    getJournalBySlug(slug, 'en'),
    getJournalBySlug(slug, 'ja')
  ]);
  itemEn = fetchedEn ?? undefined;
  itemJa = fetchedJa ?? undefined;
}

const settings = await getSettings();
const showNews = settings?.showNews ?? true;
const showJournal = settings?.showJournal ?? true;

// Fallback to one if other is missing, or use static prop, or 404 if both missing
const journalItem = itemEn || itemJa || staticItem;

if (!journalItem) {
  return Astro.redirect('/404');
}

const imageUrl = getMediaUrl(journalItem.image);
const formattedDate = new Date(journalItem.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const base = import.meta.env.BASE_URL;
---

<Layout title={`${journalItem.title} | Journal | MA3.0 World`}>
  <Header transparent={false} showNews={showNews} showJournal={showJournal} />
  
  <main class="bg-theme overflow-hidden">
    <!-- Article Header -->
    <article class="pt-32 pb-24 px-6 md:px-12">
      <div class="max-w-3xl mx-auto">
        <!-- Meta Info -->
        <div class="flex items-center gap-4 text-[10px] uppercase tracking-[0.2em] font-bold opacity-50 mb-8">
          <time datetime={journalItem.date}>
            <span class="lang-en">{new Date(journalItem.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <span class="lang-ja">{new Date(journalItem.date).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </time>
          <span class="w-1 h-1 bg-current rounded-full"></span>
          <span class="lang-en">MA3.0 Journal</span>
          <span class="lang-ja">MA3.0 ジャーナル</span>
        </div>
        
        <!-- Title -->
        <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl leading-tight mb-12">
          <span class="lang-en">{itemEn?.title || journalItem.title}</span>
          <span class="lang-ja">{itemJa?.title || journalItem.title}</span>
        </h1>
        
        <!-- Featured Image -->
        {imageUrl && (
          <div class="aspect-[16/9] bg-theme-alt rounded-sm overflow-hidden mb-12">
            <img 
              src={imageUrl} 
              alt={journalItem.title} 
              class="w-full h-full object-cover" 
            />
          </div>
        )}
        
        <!-- Description / Lead -->
        <div class="text-xl md:text-2xl leading-relaxed text-theme-muted mb-12 border-l-2 border-theme/30 pl-8">
          <div class="lang-en"><p>{itemEn?.description}</p></div>
          <div class="lang-ja"><p>{itemJa?.description}</p></div>
        </div>
        
        <!-- Rich Content -->
        {itemEn?.content && (
          <div class="lang-en prose prose-lg max-w-none text-theme">
            <RichTextRenderer node={itemEn.content.root} />
          </div>
        )}
        {itemJa?.content && (
          <div class="lang-ja prose prose-lg max-w-none text-theme">
            <RichTextRenderer node={itemJa.content.root} />
          </div>
        )}
        
        <!-- Back Link -->
        <div class="pt-16 border-t border-theme/10">
          <a href={`${base}journal`} class="text-sm uppercase tracking-widest opacity-60 hover:opacity-100 transition-opacity flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="rotate-180">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="lang-en">Back to Journal</span>
            <span class="lang-ja">ジャーナルに戻る</span>
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer showNews={showNews} showJournal={showJournal} />
</Layout>

<style>
  main {
    font-family: var(--font-sans);
  }
  h1 {
    font-family: var(--font-serif);
  }
</style>
