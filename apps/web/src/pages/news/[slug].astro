---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RichTextRenderer from '../../components/RichTextRenderer.astro';
import { getNews, getNewsBySlug, getMediaUrl, getCmsUrl, getSettings, type News } from '../../lib/cms';

export async function getStaticPaths() {
  // Fetch all news items from CMS
  const newsItems = await getNews('en');
  
  // Generate paths for CMS news items with detail pages
  const paths = newsItems
    .filter((item: News) => item.linkType === 'detail' || !item.linkType)
    .map((item: News) => ({
      params: { slug: item.slug },
      props: { newsItem: item },
    }));
  
  return paths;
}

interface Props {
  newsItem?: News;
}

const isDev = import.meta.env.DEV;
const { slug } = Astro.params;
const { newsItem: staticItem } = Astro.props;

// Fetch both English and Japanese versions
let itemEn: News | undefined;
let itemJa: News | undefined;

if (slug) {
  const [fetchedEn, fetchedJa] = await Promise.all([
    getNewsBySlug(slug, 'en'),
    getNewsBySlug(slug, 'ja')
  ]);
  itemEn = fetchedEn ?? undefined;
  itemJa = fetchedJa ?? undefined;
}

const settings = await getSettings();
const showNews = settings?.showNews ?? true;
const showJournal = settings?.showJournal ?? true;

// Fallback to one if other is missing, or use static prop, or 404 if both missing
const newsItem = itemEn || itemJa || staticItem;

if (!newsItem) {
  return Astro.redirect('/404');
}

const cmsUrl = getCmsUrl();
const imageUrl = getMediaUrl(newsItem.image, { width: 1600 });
const formattedDate = new Date(newsItem.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const base = import.meta.env.BASE_URL;
---

<Layout title={`${newsItem.title} | MA3 World News`}>
  <Header transparent={false} showNews={showNews} showJournal={showJournal} />
  
  <main class="bg-theme overflow-hidden">
    <!-- Article Header -->
    <article class="pt-32 pb-24 px-6 md:px-12">
      <div class="max-w-4xl mx-auto">
        <!-- Meta Info -->
        <div class="flex items-center gap-4 text-[10px] uppercase tracking-[0.2em] font-bold opacity-50 mb-8">
          <time datetime={newsItem.date}>
            <span class="lang-en">{new Date(newsItem.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            <span class="lang-ja">{new Date(newsItem.date).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          </time>
          <span class="w-1 h-1 bg-current rounded-full"></span>
          <span class="lang-en">MA3 Press</span>
          <span class="lang-ja">MA3 プレス</span>
        </div>
        
        <!-- Title -->
        <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl leading-tight mb-12">
          <span class="lang-en">{itemEn?.title || newsItem.title}</span>
          <span class="lang-ja">{itemJa?.title || newsItem.title}</span>
        </h1>
        
        <!-- Featured Image -->
        {imageUrl && (
          <div class="aspect-[16/9] bg-theme-alt rounded-sm overflow-hidden mb-12">
            <img 
              src={imageUrl} 
              alt={newsItem.title} 
              class="w-full h-full object-cover" 
            />
          </div>
        )}
        
        <!-- Description / Lead -->
        <div class="text-xl md:text-2xl leading-relaxed text-theme-muted mb-12 border-l-2 border-theme/30 pl-8">
          <div class="lang-en"><p>{itemEn?.description}</p></div>
          <div class="lang-ja"><p>{itemJa?.description}</p></div>
        </div>
        
        <!-- Rich Content -->
        {itemEn?.content && (
          <div class="lang-en prose prose-lg max-w-none text-theme">
            <RichTextRenderer node={itemEn.content.root} />
          </div>
        )}
        {itemJa?.content && (
          <div class="lang-ja prose prose-lg max-w-none text-theme">
            <RichTextRenderer node={itemJa.content.root} />
          </div>
        )}
        
        <!-- Back Link -->
        <div class="pt-16 border-t border-theme/10">
          <a href={`${base}news`} class="text-sm uppercase tracking-widest opacity-60 hover:opacity-100 transition-opacity flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="rotate-180">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="lang-en">Back to News</span>
            <span class="lang-ja">ニュースに戻る</span>
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer showNews={showNews} showJournal={showJournal} />
</Layout>

<style>
  main {
    font-family: var(--font-sans);
  }
  h1 {
    font-family: var(--font-serif);
  }
</style>
