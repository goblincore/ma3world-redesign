---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getFeaturedProjects, getMediaUrl, getCmsUrl, getSettings, type Project } from '../../lib/cms';

// Fetch Featured Projects from CMS for both languages (respects custom ordering)
const [cmsProjectsEn, cmsProjectsJa] = await Promise.all([
  getFeaturedProjects('en'),
  getFeaturedProjects('ja')
]);
const cmsUrl = getCmsUrl();

const settings = await getSettings();
const showNews = settings?.showNews ?? true;
const showJournal = settings?.showJournal ?? true;

// Transform CMS data to match component props, merging EN and JA content
const projects = cmsProjectsEn.map((item: Project) => {
  const jaItem = cmsProjectsJa.find(ja => ja.slug === item.slug);
  const imageUrl = getMediaUrl(item.image, { width: 1000 });
  return {
    title: item.title,
    titleJa: jaItem?.title || item.title,
    slug: item.slug,
    category: item.category,
    categoryJa: jaItem?.category || item.category,
    year: item.year,
    image: imageUrl || undefined,
    description: item.description,
    descriptionJa: jaItem?.description || item.description
  };
});

const base = import.meta.env.BASE_URL;
---

<Layout title="Projects | MA3 World">
  <Header showNews={showNews} showJournal={showJournal} />
  
  <main class="bg-theme pt-32 pb-32 px-6 md:px-12 min-h-screen">
    <div class="max-w-7xl mx-auto">
      <header class="mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div class="max-w-2xl">
          <h1 class="text-6xl md:text-8xl font-serif mb-8">
            <span class="lang-en">Projects</span>
            <span class="lang-ja">プロジェクト</span>
          </h1>
          <p class="text-xl md:text-2xl opacity-60 leading-relaxed font-light">
            <span class="lang-en">A curation of hybrid cultural innovations, digital-physical products, and immersive experiences.</span>
            <span class="lang-ja">ハイブリッドな文化革新、デジタル・フィジカル製品、没入型体験のキュレーション。</span>
          </p>
        </div>
        
        <div class="hidden md:block text-right">
          <div class="text-5xl font-serif">0{projects.length}</div>
        </div>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-24">
        {projects.map((project, index) => (
          <a href={`${base}projects/${project.slug}`} class="group relative block">
            <div class="aspect-[16/10] bg-theme-muted overflow-hidden rounded-sm mb-8 relative group">
              {project.image ? (
                <img 
                  src={project.image} 
                  alt={project.title} 
                  class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center relative">
                  <div class="absolute inset-0 bg-theme-alt transition-transform duration-1000 group-hover:scale-105"></div>
                  <span class="text-6xl md:text-8xl font-serif text-theme-muted relative z-10 transition-opacity group-hover:opacity-80">
                    0{index + 1}
                  </span>
                </div>
              )}
              <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-700 flex items-center justify-center z-20">
                <div class="w-16 h-16 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center scale-90 group-hover:scale-100 transition-transform duration-500">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
            
            <div class="space-y-4">
              <div class="flex items-center justify-between gap-4 flex-wrap">
                <span class="text-[10px] uppercase tracking-[0.3em] font-bold opacity-50">
                  <span class="lang-en">{project.category}</span>
                  <span class="lang-ja">{project.categoryJa}</span>
                </span>
                <span class="text-[10px] font-bold opacity-30 tracking-widest whitespace-nowrap">{project.year}</span>
              </div>
              
              <h2 class="text-2xl md:text-4xl font-serif leading-tight group-hover:opacity-60 transition-opacity">
                <span class="lang-en">{project.title}</span>
                <span class="lang-ja">{project.titleJa}</span>
              </h2>
              
              <p class="text-base md:text-lg opacity-60 leading-relaxed max-w-xl">
                <span class="lang-en">{project.description}</span>
                <span class="lang-ja">{project.descriptionJa}</span>
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer showNews={showNews} showJournal={showJournal} />
</Layout>

<style>
  h1, h2 {
    font-family: var(--font-serif);
  }
</style>
