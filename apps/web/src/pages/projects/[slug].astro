---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RichTextRenderer from '../../components/RichTextRenderer.astro';
import { getProjects, getProjectBySlug, getMediaUrl, getCmsUrl, getSettings, type Project } from '../../lib/cms';

export async function getStaticPaths() {
  // Fetch all projects from CMS
  const projects = await getProjects('en');
  
  // Generate paths for CMS projects
  const paths = projects.map((project: Project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
  
  return paths;
}

interface Props {
  project?: Project;
}

const isDev = import.meta.env.DEV;
const { slug } = Astro.params;
const { project: staticProject } = Astro.props;

// Fetch both English and Japanese versions
let projectEn: Project | undefined;
let projectJa: Project | undefined;

if (slug) {
  const [fetchedEn, fetchedJa] = await Promise.all([
    getProjectBySlug(slug, 'en'),
    getProjectBySlug(slug, 'ja')
  ]);
  projectEn = fetchedEn ?? undefined;
  projectJa = fetchedJa ?? undefined;
}

const settings = await getSettings();
const showNews = settings?.showNews ?? true;
const showJournal = settings?.showJournal ?? true;

// Fallback to one if other is missing, or use static prop, or 404 if both missing
const project = projectEn || projectJa || staticProject;

if (!project) {
  return Astro.redirect('/404');
}

const cmsUrl = getCmsUrl();
const mainImageUrl = getMediaUrl(project.image);
const heroImageUrl = project.heroImage ? getMediaUrl(project.heroImage) : mainImageUrl;
const fallbackImageUrl = heroImageUrl || mainImageUrl;

const base = import.meta.env.BASE_URL;
const assetBase = import.meta.env.PROD ? 'https://ma3worldbunny.b-cdn.net/' : base;
---

<Layout title={`${project.title} | MA3.0 World`}>
  <Header transparent={false} showNews={showNews} showJournal={showJournal} />
  
  <main class="bg-theme">
    <!-- Hero Section -->
    <section class="project-hero relative min-h-[60vh] flex items-end pb-12 md:pb-24 px-6 md:px-12 overflow-hidden bg-theme">
      <!-- Background Media -->
      <div class="absolute inset-0 z-0">
        <!-- Video Background (if available) -->
        {project.heroVideo ? (
          <video 
            id="project-video"
            src={project.heroVideo.startsWith('http') ? project.heroVideo : `${assetBase}${project.heroVideo.startsWith('/') ? project.heroVideo.slice(1) : project.heroVideo}`} 
            autoplay 
            loop 
            muted 
            playsinline 
            class="w-full h-full object-cover opacity-40"
          ></video>
        ) : (
          fallbackImageUrl && (
            <img 
              src={fallbackImageUrl} 
              alt={project.title}
              class="w-full h-full object-cover opacity-40"
            />
          )
        )}
        <div class="hero-overlay absolute inset-0 z-10"></div>
      </div>

      <!-- Content Overlay -->
      <div class="relative z-10 max-w-7xl w-full mx-auto pt-32">
        <div class="max-w-4xl space-y-6">
          <span class="text-[10px] md:text-xs tracking-[0.4em] uppercase font-bold opacity-50 block mb-4">
            <span class="lang-en">{projectEn?.category || project.category}</span>
            <span class="lang-ja">{projectJa?.category || project.category}</span>
          </span>
          <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl leading-[0.9]">
            <span class="lang-en">{projectEn?.title || project.title}</span>
            <span class="lang-ja">{projectJa?.title || project.title}</span>
          </h1>
          
          <div class="flex flex-wrap items-center gap-x-8 gap-y-4 pt-8 border-t border-current/10">
            {(projectEn?.client || projectJa?.client) && (
              <div class="flex items-center gap-3">
                <span class="text-[10px] uppercase tracking-[0.3em] font-bold opacity-50">
                  <span class="lang-en">Client</span>
                  <span class="lang-ja">クライアント</span>
                </span>
                <span class="text-sm md:text-base opacity-80">
                  <span class="lang-en">{projectEn?.client}</span>
                  <span class="lang-ja">{projectJa?.client || projectEn?.client}</span>
                </span>
              </div>
            )}
            <div class="flex items-center gap-3">
              <span class="text-[10px] uppercase tracking-[0.3em] font-bold opacity-50">
                <span class="lang-en">Year</span>
                <span class="lang-ja">年度</span>
              </span>
              <span class="text-sm md:text-base opacity-80">{project.year}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Project Content Section -->
    <section class="py-24 md:py-32 px-6 md:px-12 flex justify-center border-b border-theme/10">
      <div class="max-w-5xl w-full space-y-16">
        <!-- Description -->
        <div class="max-w-none text-xl md:text-2xl lg:text-[32px] leading-relaxed text-theme-muted space-y-8">
          <div class="lang-en"><p>{projectEn?.description || project.description}</p></div>
          <div class="lang-ja"><p>{projectJa?.description || projectEn?.description || project.description}</p></div>
        </div>

        <!-- Rich Content -->
        {projectEn?.content && (
          <div class="lang-en prose max-w-none text-theme prose-p:text-lg md:prose-p:text-xl lg:prose-p:text-[26px] prose-p:leading-relaxed">
            <RichTextRenderer node={projectEn.content.root} />
          </div>
        )}
        {projectJa?.content && (
          <div class="lang-ja prose max-w-none text-theme prose-p:text-lg md:prose-p:text-xl lg:prose-p:text-[26px] prose-p:leading-relaxed">
            <RichTextRenderer node={projectJa.content.root} />
          </div>
        )}


        
        <!-- Action Buttons -->
        <div class="pt-16 border-t border-theme/10 flex flex-col md:flex-row justify-between items-center gap-8">
          {project.externalLink?.url && (
            <a href={project.externalLink.url} target="_blank" class="group relative px-12 py-6 border border-theme/20 overflow-hidden">
              <div class="absolute inset-0 bg-theme translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
              <span class="relative z-10 text-xs font-bold uppercase tracking-widest group-hover:text-theme-alt transition-colors">
                <span class="lang-en">{project.externalLink.label || 'Visit Project'}</span>
                <span class="lang-ja">{projectJa?.externalLink?.label || project.externalLink.label || 'プロジェクトを見る'}</span>
              </span>
            </a>
          )}
          
          <a href={`${base}projects`} class="text-sm uppercase tracking-widest opacity-60 hover:opacity-100 transition-opacity flex items-center gap-4">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="rotate-180">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="lang-en">Back to Projects</span>
            <span class="lang-ja">プロジェクト一覧に戻る</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer showNews={showNews} showJournal={showJournal} />
</Layout>

<style>
  main {
    font-family: var(--font-sans);
  }
  h1, h2 {
    font-family: var(--font-serif);
  }

  /* Use :global() to target elements inside RichTextRenderer because Astro scopes styles by default */
  :global(.prose) {
    max-width: none !important;
  }

  :global(.prose p) {
    font-size: 1.1rem !important;
    line-height: 1.6 !important;
    margin-bottom: 1.5rem !important;
  }

  :global(.prose h2) {
    font-size: 2.25rem !important;
    line-height: 1.1 !important;
    margin-top: 4rem !important;
    margin-bottom: 2rem !important;
    font-weight: 700 !important;
  }

  :global(.prose h3) {
    font-size: 1.85rem !important;
    line-height: 1.2 !important;
    margin-top: 3.5rem !important;
    margin-bottom: 1.5rem !important;
    font-weight: 700 !important;
  }

  :global(.prose h4) {
    font-size: 1.5rem !important;
    line-height: 1.2 !important;
    margin-top: 3rem !important;
    margin-bottom: 1.25rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    opacity: 0.9 !important;
    font-weight: 700 !important;
  }

  @media (min-width: 768px) {
    :global(.prose p) {
      font-size: 1.25rem !important;
    }
    :global(.prose h2) {
      font-size: 3rem !important;
    }
    :global(.prose h3) {
      font-size: 2.5rem !important;
    }
    :global(.prose h4) {
      font-size: 1.75rem !important;
    }
  }

  @media (min-width: 1024px) {
    :global(.prose p) {
      font-size: 26px !important;
      line-height: 1.7 !important;
    }
    :global(.prose h2) {
      font-size: 3.5rem !important;
    }
    :global(.prose h3) {
      font-size: 2.75rem !important;
    }
    :global(.prose h4) {
      font-size: 2.125rem !important;
    }
  }

  :global(.prose blockquote) {
    position: relative !important;
    border-left-width: 4px !important;
    padding-left: 4.5rem !important;
    margin-top: 5rem !important;
    margin-bottom: 5rem !important;
    font-style: italic !important;
    font-size: 1.5rem !important;
  }

  @media (min-width: 1024px) {
    :global(.prose blockquote) {
      font-size: 30px !important;
    }
  }

  :global(.prose blockquote::before) {
    content: '“' !important;
    position: absolute !important;
    left: -1rem !important;
    top: -2.5rem !important;
    font-size: 12rem !important;
    font-family: var(--font-serif) !important;
    color: var(--color-text-muted) !important;
    opacity: 0.1 !important;
    pointer-events: none !important;
  }

  :global(.prose blockquote p) {
    font-size: inherit !important;
    line-height: 1.5 !important;
    margin-bottom: 0 !important;
    color: var(--color-text-muted) !important;
  }

  /* Media centering and max-width constraints */
  :global(.prose img) {
    margin-left: auto !important;
    margin-right: auto !important;
    max-height: 85vh !important;
    object-fit: contain !important;
  }

  :global(.prose .aspect-video) {
    max-width: 900px !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }
  
  .hero-overlay {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.2), transparent);
  }
  
  :root[data-theme="light"] .hero-overlay {
    background: linear-gradient(to top, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.3), transparent);
  }
</style>
